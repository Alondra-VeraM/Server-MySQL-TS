  },
  "item": [
    {
      "name": "01 - Crear producto (POST)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "  const data = pm.response.json();",
              "  if (data.id) pm.collectionVariables.set('productId', String(data.id));",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Laptop HP Victus\",\n  \"price\": 14500,\n  \"stock\": 10,\n  \"description\": \"Laptop con 16 GB de RAM\",\n  \"brand\": \"HP\",\n  \"img\": null\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/create",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "create"
          ]
        },
        "description": "Crea un producto activo. name, price (>0), stock (entero >=0), description obligatorios; brand e img opcionales. Respuesta esperada: 201 y el id creado."
      },
      "response": []
    },
